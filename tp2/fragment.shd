    // 5. Effets ======================================================================

    // Q8 normalmap
    vec3 normal_tex = texture(normalmap_sampler, frag_uv).xyz * 2.0 - 1.0;
    vec3 N = normalize(frag_normal);
    vec3 dp1 = dFdx(frag_pos);
    vec3 dp2 = dFdy(frag_pos);
    vec2 duv1 = dFdx(frag_uv);
    vec2 duv2 = dFdy(frag_uv);
    vec3 T = normalize(dp1 * duv2.y - dp2 * duv1.y);
    vec3 B = normalize(-dp1 * duv2.x + dp2 * duv1.x);
    mat3 TBN = mat3(T, B, N);
    vec3 bumped_normal = normalize(TBN * normal_tex);
    vec3 light_dir = normalize(light_position - frag_pos);
    float lighting = clamp(dot(bumped_normal, light_dir), 0.0, 1.0);
    output_color = vec4(clamp(in_color * lighting * object_color, 0.0, 1.0), 1.0);
    
