#version 450

uniform sampler2D texture_sampler;
uniform sampler2D lighting_sampler;
uniform sampler2D normalmap_sampler;

layout(location=0) out vec4 output_color;


in vec3 in_color;
// flat in vec3 in_color;


void main() {

    // 4. TEXTURES =====================================================================

	// Q4 spot
	vec2 uv_coords = in_color.xy;
	float lighting = in_color.z;
	vec4 tex_color = texture(texture_sampler, uv_coords);
    output_color = tex_color * lighting;
    vec4 spot_color = texture(lighting_sampler, uv_coords);
    output_color = tex_color * 1.5 * spot_color;

	// Q3 texture avec lumière
